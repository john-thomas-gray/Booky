datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum ClubRole {
  OWNER
  ADMIN
  MEMBER
}

enum ReadingStatus {
  PLANNED
  READING
  FINISHED
  ABANDONED
}

enum BetOutcome {
  PENDING
  WON
  LOST
  VOID
}

enum PointReason {
  BOOK_FINISHED
  BET_WON
  BET_LOST
  BET_BONUS
  ADMIN_ADJUSTMENT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())

  memberships  ClubMember[]
  readings     Reading[]
  betsPlaced   Bet[]              @relation("BetsPlaced")
  betsTargeted Bet[]              @relation("BetsTargeted")
  points       PointTransaction[]

  ownedClubs      Club[]    @relation("ClubOwner")
  meetingsCreated Meeting[] @relation("MeetingCreator")
}

model Club {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())

  owner    User               @relation("ClubOwner", fields: [ownerId], references: [id])
  members  ClubMember[]
  meetings Meeting[]
  readings Reading[]
  bets     Bet[]
  points   PointTransaction[]
}

model ClubMember {
  id       String    @id @default(uuid())
  clubId   String
  userId   String
  role     ClubRole  @default(MEMBER)
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  club Club @relation(fields: [clubId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([clubId, userId, leftAt])
  @@index([clubId])
  @@index([userId])
}

model Book {
  id             String   @id @default(uuid())
  googleVolumeId String   @unique
  title          String
  authors        String? // store CSV for now; can migrate to json later
  pageCount      Int?
  thumbnailUrl   String?
  description    String?
  publishedDate  String?
  metadataJson   Json?
  createdAt      DateTime @default(now())

  meetings Meeting[]
  readings Reading[]
  bets     Bet[]
}

model Meeting {
  id          String   @id @default(uuid())
  clubId      String
  bookId      String
  title       String
  description String?
  scheduledAt DateTime
  createdById String
  createdAt   DateTime @default(now())

  club      Club @relation(fields: [clubId], references: [id])
  book      Book @relation(fields: [bookId], references: [id])
  createdBy User @relation("MeetingCreator", fields: [createdById], references: [id])

  readings Reading[]
  bets     Bet[]

  @@index([clubId])
  @@index([bookId])
}

model Reading {
  id         String        @id @default(uuid())
  clubId     String
  meetingId  String?
  userId     String
  bookId     String
  status     ReadingStatus @default(PLANNED)
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime      @default(now())

  club    Club     @relation(fields: [clubId], references: [id])
  meeting Meeting? @relation(fields: [meetingId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  book    Book     @relation(fields: [bookId], references: [id])

  progress     ReadingProgress?
  resolvesBets Bet[]            @relation("BetResolvedBy")

  @@index([clubId, bookId])
  @@index([userId])
}

model ReadingProgress {
  id          String   @id @default(uuid())
  readingId   String   @unique
  currentPage Int      @default(0)
  totalPages  Int?
  source      String   @default("MANUAL")
  updatedAt   DateTime @updatedAt

  reading Reading @relation(fields: [readingId], references: [id])
}

model Bet {
  id                  String     @id @default(uuid())
  clubId              String
  meetingId           String?
  bookId              String
  bettorId            String
  predictedUserId     String
  stakePoints         Int
  placedAt            DateTime   @default(now())
  resolvedAt          DateTime?
  outcome             BetOutcome @default(PENDING)
  resolvedByReadingId String?

  club              Club     @relation(fields: [clubId], references: [id])
  meeting           Meeting? @relation(fields: [meetingId], references: [id])
  book              Book     @relation(fields: [bookId], references: [id])
  bettor            User     @relation("BetsPlaced", fields: [bettorId], references: [id])
  predictedUser     User     @relation("BetsTargeted", fields: [predictedUserId], references: [id])
  resolvedByReading Reading? @relation("BetResolvedBy", fields: [resolvedByReadingId], references: [id])

  @@index([clubId, bookId, meetingId])
  @@index([outcome])
}

model PointTransaction {
  id          String      @id @default(uuid())
  clubId      String
  userId      String
  amount      Int
  reason      PointReason
  referenceId String?
  createdAt   DateTime    @default(now())

  club Club @relation(fields: [clubId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([clubId, userId])
}
